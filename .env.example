# ============================================
# SERVER-SIDE ONLY — never goes into the Expo bundle.
# Copy to .env and fill in the real values.
# ============================================

# --- Supabase ---
# Project Settings -> API
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SECRET_KEY=sb_secret_...
SUPABASE_JWKS_URL=https://<project-ref>.supabase.co/auth/v1/.well-known/jwks.json

# --- Hostaway ---
# Hostaway -> Settings -> Hostaway API
HOSTAWAY_ACCOUNT_ID=       # used as the OAuth client_id
HOSTAWAY_API_KEY=          # used as the OAuth client_secret
# Hostaway webhooks carry no signature at all — Basic Auth only.
# The same values are given when the webhook is registered in Hostaway.
HOSTAWAY_WEBHOOK_LOGIN=
HOSTAWAY_WEBHOOK_PASSWORD=

# --- Guest signals: reviews, later messages (docs/guest-signals.md, docs/reviews-to-tasks.md §10) ---
# Edge Function secrets of sync-guest-signals and classify-guest-signals; never in the database.
# The key of every guest signal: HMAC of "<provider>:<kind>:<the PMS's id>". 32+ random
# characters, created once by the owner at rollout and never changed (a new one loads every
# review again as new). Local stand: any test value of 32+ characters.
GUEST_SIGNAL_KEY_SECRET=
# The model's key; without it the rules read alone.
ANTHROPIC_API_KEY=
