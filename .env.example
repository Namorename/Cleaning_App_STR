# ============================================
# SERVER-SIDE ONLY — никогда не попадает в бандл Expo.
# Скопируйте в .env и заполните реальными значениями.
# ============================================

# --- Supabase ---
# Project Settings -> API
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SECRET_KEY=sb_secret_...
SUPABASE_JWKS_URL=https://<project-ref>.supabase.co/auth/v1/.well-known/jwks.json

# --- Hostaway ---
# Hostaway -> Settings -> Hostaway API
HOSTAWAY_ACCOUNT_ID=       # используется как OAuth client_id
HOSTAWAY_API_KEY=          # используется как OAuth client_secret
HOSTAWAY_WEBHOOK_SECRET=   # для проверки подписи входящих вебхуков
