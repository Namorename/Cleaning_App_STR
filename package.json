{
  "name": "str-ops",
  "version": "0.1.0",
  "private": true,
  "description": "Операционная система для STR-компании: уборки, обслуживание, синхронизация с Hostaway",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:diff": "supabase db diff -f",
    "db:push": "supabase db push",
    "db:types": "node scripts/gen-types.mjs",
    "fn:serve": "supabase functions serve",
    "fn:deploy": "supabase functions deploy",
    "test:rls": "node scripts/test-rls.mjs",
    "test:fn": "deno test --allow-read supabase/functions/"
  },
  "devDependencies": {
    "deno": "2.9.5",
    "supabase": "2.115.0"
  }
}
