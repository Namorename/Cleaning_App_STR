EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Crash reports (optional): the DSN of the Sentry project. Empty in development;
# a build takes it from the EAS environment of its profile, and an OTA update
# only when published with --environment (eas update); without the flag the
# update ships with no crash reports.
EXPO_PUBLIC_SENTRY_DSN=
