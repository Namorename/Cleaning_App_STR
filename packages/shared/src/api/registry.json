  "forbidden": [
    { "id": "api_keys:manage", "reason": "A key that issues keys outlives its own revocation: one leak would become permanent." },
    { "id": "staff:manage_privileged", "reason": "Credentials and roles of admins and managers: a key could make itself an admin or take over the owner's account." },
    { "id": "staff:read_contacts", "reason": "E-mails and phone numbers of staff are personal data; the API identifies people by id." },
    { "id": "guests:read_personal", "reason": "Guest names, contacts and messages are personal data; bookings are served without them." },
    { "id": "access_codes:read", "reason": "Door, lockbox and keypad codes give physical access to a property." },
    { "id": "integrations:read_secrets", "reason": "Secrets and tokens of Hostaway, webhooks and push devices are someone else's credentials." },
    { "id": "hostaway:write", "reason": "Hostaway is the source of truth; the API only reads woom's copy of it." },
    { "id": "data:destroy", "reason": "Irreversible deletion cannot be undone if a key leaks; v1 only cancels and archives." },
    { "id": "security:write", "reason": "A key must not weaken the security settings that restrict it." },
    { "id": "tenants:cross", "reason": "Each company sees only its own data; the company always comes from the key." }
  ]
