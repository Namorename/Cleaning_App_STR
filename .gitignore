# --- expo ---
# Паттерны привязаны к apps/mobile: без ведущего слэша `ios/` и `*.key`
# срабатывают на любой глубине и молча выкидывают чужие файлы из коммита.
.expo/
.expo-shared/
/apps/mobile/ios/
/apps/mobile/android/
/apps/mobile/**/*.jks
/apps/mobile/**/*.p8
/apps/mobile/**/*.p12
/apps/mobile/**/*.keystore
/apps/mobile/**/*.mobileprovision

# --- supabase ---
supabase/.branches/
supabase/.temp/
supabase/.env

# --- tooling ---
.turbo/
coverage/
*.log
npm-debug.log*

# --- os / editors ---
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/*
!.vscode/extensions.json

# --- vendor docs (крупные бинарники держим локально) ---
docs/vendor/*
!docs/vendor/README.md

